# ==============================================================================
# SHM 2.0 - Arquivo de Configuração de Ambiente (.env.example)
# Copie este arquivo para .env e preencha com as credenciais reais.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google OAuth2 (Autenticação Google)
# Obtenha em: https://console.cloud.google.com/apis/credentials (Aplicativo Web)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=seu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_google_client_secret
VITE_GOOGLE_CLIENT_ID=seu_google_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Django Backend Settings
# ------------------------------------------------------------------------------
SECRET_KEY=django-insecure-shm-production-ready-super-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=*

# ------------------------------------------------------------------------------
# Frontend & URLs
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# E-mail SMTP (Gmail ou provedor SMTP)
# Para Gmail: use "Senha de App" gerada em https://myaccount.google.com/apppasswords
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu_email@dominio.com
EMAIL_HOST_PASSWORD=sua_senha_de_app_16_digitos
DEFAULT_FROM_EMAIL=SHM Suporte <seu_email@dominio.com>

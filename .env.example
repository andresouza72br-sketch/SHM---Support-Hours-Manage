# ==============================================================================
# SHM 2.0 - Arquivo de Configuração de Ambiente (.env.example)
# Copie este arquivo para .env e preencha com as credenciais reais.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google OAuth2 (Autenticação Google)
# Obtenha em: https://console.cloud.google.com/apis/credentials (Aplicativo Web)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=seu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_google_client_secret
VITE_GOOGLE_CLIENT_ID=seu_google_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Django Backend Settings
# ------------------------------------------------------------------------------
SECRET_KEY=django-insecure-shm-production-ready-super-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=*

# ------------------------------------------------------------------------------
# Frontend & URLs
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Tailscale & Acesso Remoto em Rede Local (Opcional)
# Defina o IP Tailscale da máquina para permitir acesso via VPN/rede interna
# ------------------------------------------------------------------------------
TAILSCALE_IP=
# CSRF_TRUSTED_ORIGINS=http://100.x.y.z:5173,http://100.x.y.z:8000

# ------------------------------------------------------------------------------
# E-mail SMTP (Servidor Local ou Provedor SMTP)
# ------------------------------------------------------------------------------
# Opção A: Servidor Local de Desenvolvimento (tools/mail-server)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SHM Suporte <suporte@shm.local>

# Opção B: SMTP Produção (Gmail / Provedor Comercial)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=seu_email@dominio.com
# EMAIL_HOST_PASSWORD=sua_senha_de_app_16_digitos
# DEFAULT_FROM_EMAIL=SHM Suporte <seu_email@dominio.com>

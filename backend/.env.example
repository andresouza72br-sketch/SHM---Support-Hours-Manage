# ==============================================================================
# SHM 2.0 Backend - Variáveis de Ambiente (.env.example)
# ==============================================================================

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=seu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_google_client_secret

# Django Settings
SECRET_KEY=django-insecure-shm-production-ready-super-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=*

# Frontend Base URL
FRONTEND_URL=http://localhost:5173

# E-mail SMTP (Gmail)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu_email@dominio.com
EMAIL_HOST_PASSWORD=sua_senha_de_app_16_digitos
DEFAULT_FROM_EMAIL=SHM Suporte <seu_email@dominio.com>
